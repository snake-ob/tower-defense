[sub_resource type="GDScript" id="GDScript_a23sr"]
resource_name = "Chase"
script/source = "extends State

var bullet_spawner = null
var physics: Node
var grab: Node
var stutter_step: bool = false
var sprite: AnimatedSprite2D
var animanager: AniManager
var current_speed: float
var smash_timer: Timer
var timing: bool = false
var sm: StateMachine
var wall_detector: WallDetector

func _ready():
	smash_timer = Timer.new()
	smash_timer.one_shot = true
	add_child(smash_timer)
	
func _setup(p_ref):
	ref = p_ref
	actor = p_ref.actor
	physics = p_ref.physics
	grab = p_ref.grab
	sprite = p_ref.sprite
	animanager = p_ref.animanager
	sm = p_ref.state_machine
	wall_detector = p_ref.wall_detector
	if ref.has('bullet_spawner'):
		bullet_spawner = ref.bullet_spawner
	
func _enter_state():
	if bullet_spawner:
		bullet_spawner.activate()
	if not smash_timer.timeout.is_connected(_on_smash_timeout):
		smash_timer.timeout.connect(_on_smash_timeout)
	
func _exit_state():
	if bullet_spawner:
		bullet_spawner.deactivate()

	if smash_timer.timeout.is_connected(_on_smash_timeout):
		smash_timer.timeout.disconnect(_on_smash_timeout)
	
	smash_timer.stop()


func _physics_update(delta):
	if sm.has_state('smash'):
		if wall_detector.is_colliding():
			change_state.emit(\"stretch\")

	sprite.speed_scale = 1
	current_speed = actor.move.speed
	if ref.active_targets == []:
		change_state.emit('reset')
		return
		
	physics._process_friction(delta)
	_check_slow()
	_move_actor(delta)
	
func _prep_smash():
	var approx_velocity = actor.velocity.floor()
	if actor.is_on_wall():
		if not timing:
			smash_timer.start(0.5)
			timing = true
	else:
		timing = false

func _on_smash_timeout():
	if sm.current_state != self:
		print(\"Timer finished in void state\")
		return
	if sm.has_state('stretch'):
		change_state.emit('Stretch')

func _check_slow():
	if actor.slowed_down:
		sprite.speed_scale = 0.5
		if stutter_step:
			current_speed = 0.1
			stutter_step = false
		else:
			stutter_step = true

func _move_actor(delta):
	var target = ref.active_targets[0]
	var target_pos = target.global_position
	var actor_pos = actor.global_position

	var direction = actor_pos.direction_to(target_pos)
	var target_velocity = direction * current_speed
	actor.update_target(target_pos)
	
	if actor.slowed_down:
		actor.velocity = target_velocity
	else:
		actor.velocity = actor.velocity.move_toward(target_velocity, ref.move.acceleration * delta)

func _update(delta):
	var pickups = grab.get_grabbable()
	if pickups != []:
		grab.grabbed_pickup = pickups[0]
		grab._pickup_object(pickups[0])
		change_state.emit('carry')
"

[sub_resource type="GDScript" id="GDScript_opqqp"]
script/source = "extends State

var physics: Node
var grab: Node
var soft_collision = Node
var stored_force: float
var pickup: Node
var sprite: AnimatedSprite2D
var current_speed: float
var stutter_step: bool = false

var target_pos: Vector2
	
func _setup(p_ref):
	ref = p_ref
	actor = p_ref.actor
	physics = p_ref.physics
	grab = p_ref.grab
	soft_collision = p_ref.soft_collision
	pickup = p_ref.pickup
	sprite = p_ref.sprite
	
func _enter_state():
	actor.ref.target = Vector2.ZERO
	SignalBus.request_closest_exit.emit(actor)
	stored_force = soft_collision.push_force
	soft_collision.push_force = 2
	pickup.monitorable = false
	
func _exit_state():
	grab._drop()
	soft_collision.push_force = stored_force
	pickup.set_deferred('monitorable', true)

func _physics_update(delta):
	sprite.speed_scale = 1
	current_speed = actor.move.speed
	if ref.active_targets == []:
		change_state.emit('reset')
		return
		
	physics._process_friction(delta)
	_check_slow()
	_move_actor(delta)

func _check_slow():
	if actor.slowed_down:
		sprite.speed_scale = 0.5
		if stutter_step:
			current_speed = 0.1
			stutter_step = false
		else:
			stutter_step = true

func _move_actor(delta):
	var target_pos = ref.target
	var actor_pos = actor.global_position

	var direction = actor_pos.direction_to(target_pos)
	var target_velocity = direction * current_speed
	actor.update_target(target_pos)
	
	if actor.slowed_down:
		actor.velocity = target_velocity
	else:
		actor.velocity = actor.velocity.move_toward(target_velocity, ref.move.acceleration * delta)

func catch_exit_pos(p_pos):
	target_pos = p_pos
	actor.ref.target = p_pos
"

[sub_resource type="GDScript" id="GDScript_im3kb"]
script/source = "extends State
var sprite: AnimatedSprite2D
var current_speed: float
var physics: PhysicsHandler
var stutter_step: bool = false
var smash_timer: Timer
var sm: StateMachine
var timing: bool = false
var wall_detector: WallDetector

func _setup(p_ref):
	ref = p_ref
	actor = ref.actor
	sprite = p_ref.sprite
	physics = p_ref.physics
	sm = p_ref.state_machine
	wall_detector = p_ref.wall_detector
	
	
func _ready():
	smash_timer = Timer.new()
	smash_timer.one_shot = true
	add_child(smash_timer)
	
func _enter_state():
	if not smash_timer.timeout.is_connected(_smash_timeout):
		smash_timer.timeout.connect(_smash_timeout)

func _exit_state():
	if smash_timer.timeout.is_connected(_smash_timeout):
		smash_timer.timeout.disconnect(_smash_timeout)
	smash_timer.stop()

func _smash_timeout():
	if sm.has_state('stretch'):
		change_state.emit('stretch')

func _physics_update(delta):
	if sm.has_state('smash'):
		_prep_smash()

	if ref.active_targets:
		change_state.emit('chase')
		return
	
	sprite.speed_scale = 1
	current_speed = actor.move.speed

	physics._process_friction(delta)
	_check_slow()
	_move_actor(delta)
	
func _prep_smash():
	var approx_velocity = actor.velocity.floor()
	if wall_detector.is_colliding():
		if not timing:
			smash_timer.start(0.5)
			timing = true
	else:
		timing = false

func _check_slow():
	if actor.slowed_down:
		sprite.speed_scale = 0.5
		if stutter_step:
			current_speed = 0.1
			stutter_step = false
		else:
			stutter_step = true

func _move_actor(delta):
	var actor_pos = actor.global_position

	var direction = actor_pos.direction_to(actor.centre_pos)
	var target_velocity = direction * current_speed
	actor.update_target(actor.centre_pos)
	
	if actor.slowed_down:
		actor.velocity = target_velocity
	else:
		actor.velocity = actor.velocity.move_toward(target_velocity, ref.move.acceleration * delta)
"

[sub_resource type="GDScript" id="GDScript_11bei"]
script/source = "#Die.gd

extends State

var animanager: Node
var collision: Node
var death_speed: float = 2.0
var hitbox: Hitbox
var sprite: AnimatedSprite2D
@export var booming_death: bool = false
var boomed: bool =  false
var dust_path: String = \"res://common/components/Dust.tscn\"

func _setup(p_ref):
	actor = p_ref.actor
	animanager = p_ref.animanager
	collision = p_ref.collision
	hitbox = p_ref.hitbox
	sprite = p_ref.sprite

func _enter_state():
	if sprite.material:
		sprite.material.set_shader_parameter('active', false)
	actor.set_collision_layer_value(9, false)
	hitbox.monitoring = false
	collision.set_deferred('disabled', true)
	animanager.play_death()
	actor.velocity = Vector2.ZERO
	await get_tree().create_timer(death_speed).timeout
	flicker()
	
func _physics_update(delta):
	actor.velocity = Vector2.ZERO
	if booming_death:
		_death_boom()
		
func _death_boom():
	#check for frame 2 of death animation (hitting ground)
	#check if boom has already happened
	#spawn 3-4 dust explosions
	if boomed:
		return
	if sprite.frame != 1:
		return
	var dust_scene = load(dust_path)

	boomed = true
	var rand_num = randi_range(3, 4)
	for i in range(rand_num):
		var dust = dust_scene.instantiate()
		var random_vec = Vector2(randf_range(-16.0, 16.0), randf_range(-16.0, 16.0))
		dust.global_position = actor.global_position + random_vec
		SignalBus.spawn_bullet.emit(dust)
	
func flicker():
	var flicker_count = 8
	var flicker_speed = 0.05
	
	for i in range(flicker_count):
		actor.visible = !actor.visible
		await get_tree().create_timer(flicker_speed).timeout
	
	actor.queue_free()
"

[sub_resource type="GDScript" id="GDScript_qu3yx"]
script/source = "extends State

var physics: Node
var grab: Node
var soft_collision = Node
var stored_force: float
var pickup: Node
var sprite: AnimatedSprite2D
var current_speed: float
var stutter_step: bool = false

var target_pos: Vector2
	
func _setup(p_ref):
	ref = p_ref
	actor = p_ref.actor
	physics = p_ref.physics
	grab = p_ref.grab
	soft_collision = p_ref.soft_collision
	pickup = p_ref.pickup
	sprite = p_ref.sprite
	
func _enter_state():
	actor.ref.target = Vector2.ZERO
	SignalBus.request_closest_exit.emit(actor)

func _physics_update(delta):
	sprite.speed_scale = 1
	current_speed = actor.move.speed
		
	physics._process_friction(delta)
	_check_slow()
	_move_actor(delta)

func _check_slow():
	if actor.slowed_down:
		sprite.speed_scale = 0.5
		if stutter_step:
			current_speed = 0.1
			stutter_step = false
		else:
			stutter_step = true

func _move_actor(delta):
	var target_pos = ref.target
	var actor_pos = actor.global_position

	var direction = actor_pos.direction_to(target_pos)
	var target_velocity = direction * current_speed
	actor.update_target(target_pos)
	
	if actor.slowed_down:
		actor.velocity = target_velocity
	else:
		actor.velocity = actor.velocity.move_toward(target_velocity, ref.move.acceleration * delta)

func catch_exit_pos(p_pos):
	target_pos = p_pos
	actor.ref.target = p_pos
"

