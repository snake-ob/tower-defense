[sub_resource type="GDScript" id="GDScript_61d7m"]
script/source = "extends State

var pickup: Area2D
var soft_collision: Area2D
var physics: Node

func _setup(p_ref):
	pickup = p_ref.pickup
	soft_collision = p_ref.soft_collision
	physics = p_ref.physics

func _update(delta):
	if pickup.picked_up:
		change_state.emit('picked')

func _enter_state():
	soft_collision.enable()

func _physics_update(delta):
	physics._process_friction(delta)
"

[sub_resource type="GDScript" id="GDScript_duxdq"]
script/source = "extends State

var pickup: Area2D
var soft_collision
var state_active: bool = false
var shop: Node2D

func _ready():
	GlobalClick.rmb_click.connect(_on_rmb_click)

func _setup(p_ref):
	soft_collision = p_ref.soft_collision
	pickup = p_ref.pickup
	actor = p_ref.actor
	shop = p_ref.shop
	

func _update(delta):
	if not pickup.picked_up:
		change_state.emit('idle')

func _enter_state():
	DiagBus.set_active_state('shopping')
	DiagBus.new_state.emit()
	soft_collision.disable()
	state_active = true
	shop.visible = true


func _exit_state():
	DiagBus.reset_state()
	
	soft_collision.enable()
	state_active = false
	shop.visible = false
	
func _display_shop():
	pass

func _on_rmb_click():
	if not state_active: return
	actor.purchase_requested()
"

